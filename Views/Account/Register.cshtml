@model PageWhisphers.Models.RegisterViewModel

@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex align-items-center justify-content-center min-vh-100">
    <div class="card shadow-lg border-0 rounded-3 animate__animated animate__fadeIn" style="background: #1e293b; max-width: 500px; width: 100%;">
        <div class="card-header rounded-top-3 text-white py-4" style="background: linear-gradient(90deg, #312e81, #14b8a6);">
            <h2 class="mb-0 fw-bold text-center" style="font-family: 'Merriweather', serif; font-size: 2rem;">
                <i class="bi bi-person-plus-fill me-2 text-teal-500"></i>Register for Page Whispers
            </h2>
        </div>
        <div class="card-body p-5 text-white">
            <form asp-action="Register" method="post">
                <div asp-validation-summary="All" class="text-red-400 mb-4 text-center alert alert-danger d-none" role="alert">
                    <span class="validation-summary-errors"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="FirstName" class="form-label fw-semibold text-teal-400">
                        <i class="bi bi-person me-2"></i>First Name
                    </label>
                    <input asp-for="FirstName" class="form-control bg-gray-700 text-white border-gray-600 focus:ring-teal-500 focus:border-teal-500" placeholder="Enter your first name" />
                    <span asp-validation-for="FirstName" class="text-red-400 d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="LastName" class="form-label fw-semibold text-teal-400">
                        <i class="bi bi-person me-2"></i>Last Name
                    </label>
                    <input asp-for="LastName" class="form-control bg-gray-700 text-white border-gray-600 focus:ring-teal-500 focus:border-teal-500" placeholder="Enter your last name" />
                    <span asp-validation-for="LastName" class="text-red-400 d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label fw-semibold text-teal-400">
                        <i class="bi bi-envelope-fill me-2"></i>Email
                    </label>
                    <input asp-for="Email" class="form-control bg-gray-700 text-white border-gray-600 focus:ring-teal-500 focus:border-teal-500" placeholder="Enter your email" />
                    <span asp-validation-for="Email" class="text-red-400 d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="form-label fw-semibold text-teal-400">
                        <i class="bi bi-lock-fill me-2"></i>Password
                    </label>
                    <input asp-for="Password" class="form-control bg-gray-700 text-white border-gray-600 focus:ring-teal-500 focus:border-teal-500" placeholder="Enter your password" />
                    <span asp-validation-for="Password" class="text-red-400 d-block mt-1"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold text-teal-400">
                        <i class="bi bi-lock-fill me-2"></i>Confirm Password
                    </label>
                    <input asp-for="ConfirmPassword" class="form-control bg-gray-700 text-white border-gray-600 focus:ring-teal-500 focus:border-teal-500" placeholder="Confirm your password" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-400 d-block mt-1"></span>
                </div>

                <button type="submit" class="w-full btn btn-teal-500 text-white rounded-pill py-3 shadow-lg hover:bg-teal-600 transition-transform duration-300 transform hover:scale-105">
                    <i class="bi bi-person-plus-fill me-2"></i>Register
                </button>

                <div class="mt-4 text-center">
                    <a href="/Account/Login" class="text-teal-400 hover:text-teal-300 transition-colors duration-300 hover:underline">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Already have an account? Login here
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <style>
        /* Button Styling */
        .btn-teal-500 {
            background-color: #14b8a6;
            color: white;
            border: none;
        }

            .btn-teal-500:hover {
                background-color: #15d1bb;
                color: white;
            }

        /* Text Color Utilities */
        .text-teal-400 {
            color: #2dd4bf;
        }

        .text-teal-300 {
            color: #4dd0e1;
        }

        .text-teal-500 {
            color: #14b8a6;
        }

        .animate__fadeIn {
            animation-duration: 1s;
        }

        /* Enhanced Input Styling */
        .form-control {
            background-color: #334155; /* Slightly lighter than bg-gray-700 */
            color: #f1f5f9; /* Bright text for contrast */
            border: 1px solid #475569;
            transition: all 0.3s ease;
        }

            .form-control::placeholder {
                color: #94a3b8;
                opacity: 1;
            }

            .form-control:focus {
                background-color: #1e293b;
                border-color: #14b8a6;
                box-shadow: 0 0 0 0.2rem rgba(20, 184, 166, 0.25);
                color: #f8fafc;
            }

        /* Label improvements */
        .form-label {
            margin-bottom: 0.5rem;
        }

        /* Validation styling consistency */
        .text-red-400 {
            color: #f87171;
        }
    </style>
    <script>
        // Show validation summary if there are errors
        document.addEventListener('DOMContentLoaded', () => {
            const validationSummary = document.querySelector('.validation-summary-errors');
            const alert = validationSummary?.closest('.alert');
            if (validationSummary && validationSummary.children.length > 0) {
                alert.classList.remove('d-none');
                alert.querySelector('span').innerHTML = validationSummary.innerHTML;
            }
        });
    </script>

}